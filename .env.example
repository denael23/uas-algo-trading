# Salin menjadi .env (file .env TIDAK PERNAH di-commit atau dikumpulkan).
# Connection string Neon Postgres, dari Vercel Marketplace / dashboard Neon.
DATABASE_URL=
# Secret panjang acak untuk melindungi /api/tick, /api/kill, /api/catatan, /api/health.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
